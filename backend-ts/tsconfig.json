{
  "compilerOptions": {
    "module": "NodeNext", // Quy định output module được sử dụng
    "moduleResolution": "NodeNext",
    "target": "ES2023", // Target output cho code
    "rootDir": "./src",
    "outDir": "dist", // Đường dẫn output cho thư mục build
    "esModuleInterop": true, // dùng để enable interoperability giữa các module
    "isolatedModules": true, // dùng để kiểm tra tính chính xác của code
    "strict": true /* Enable all strict type-checking options. */, // dùng để kiểm tra tính chính xác của code
    "skipLibCheck": true /* Skip type checking all .d.ts files. */, // dùng để bỏ qua kiểm tra tính chính xác của file .d.ts
    "baseUrl": ".", // Đường dẫn base cho các import // dùng để import file từ thư mục gốc
    "resolveJsonModule": true, // dùng để enable json module
    "forceConsistentCasingInFileNames": true, // dùng để kiểm tra tính chính xác của file
    "paths": {
      "~/*": ["src/*"] // Đường dẫn tương đối cho các import (alias) // dùng để import file từ thư mục con
    }
  },
  "files": ["src/type.d.ts"], // Các file dùng để defined global type cho dự án
  "include": ["src/**/*", "__tests__/**/*"], // Đường dẫn include cho các file cần build
  "exclude": ["node_modules", "dist"]
}
